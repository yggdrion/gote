{
    "extends": [
        "config:recommended",
        ":dependencyDashboard",
        "helpers:pinGitHubActionDigests",
        ":semanticCommits"
    ],
    "schedule": [
        "on saturday"
    ],
    "assignees": [
        "r4b2"
    ],
    "labels": [
        "dependencies"
    ],
    "semanticCommits": "enabled",
    "recreateWhen": "always",
    "separateMajorMinor": false,
    "packageRules": [
        {
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "github-actions",
            "commitMessagePrefix": "chore(github-actions): ",
            "pinDigests": true,
            "labels": [
                "dependencies",
                "github-actions"
            ]
        },
        {
            "matchManagers": [
                "terraform"
            ],
            "groupName": "terraform",
            "commitMessagePrefix": "chore(terraform): ",
            "labels": [
                "dependencies",
                "terraform"
            ]
        },
        {
            "matchManagers": [
                "cargo"
            ],
            "groupName": "rust",
            "commitMessagePrefix": "chore(rust): ",
            "labels": [
                "dependencies",
                "rust"
            ]
        },
        {
            "matchManagers": [
                "npm"
            ],
            "groupName": "npm",
            "commitMessagePrefix": "chore(npm): ",
            "labels": [
                "dependencies",
                "npm"
            ]
        },
        {
            "matchManagers": [
                "pip_requirements"
            ],
            "groupName": "python",
            "commitMessagePrefix": "chore(python): ",
            "labels": [
                "dependencies",
                "python"
            ]
        },
        {
            "matchManagers": [
                "docker-compose"
            ],
            "matchFileNames": [
                "**/docker-compose.yml"
            ],
            "groupName": "docker-compose",
            "commitMessagePrefix": "chore(docker-compose): ",
            "labels": [
                "dependencies",
                "docker"
            ]
        },
        {
            "description": "Tauri's CLI refuses to build when the npm packages and the Rust crates differ in major/minor, so update them together",
            "matchPackageNames": [
                "tauri",
                "tauri-build",
                "/^tauri-plugin-/",
                "/^@tauri-apps\\//"
            ],
            "groupName": "tauri",
            "commitMessagePrefix": "chore(tauri): ",
            "labels": [
                "dependencies",
                "tauri"
            ]
        }
    ]
}
