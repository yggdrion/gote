<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="gote.exe"
        Arguments=""
        InstallLocation="C:\Program Files\r4b2\gote">
    </Installer>
    <PackageInformation
        PackageName="gote"
        PackageDisplayName="gote"
        PublisherName="CN=r4b2"
        PublisherDisplayName="r4b2"
        Version="1.6.3.0"
        PackageDescription="A secure note-taking application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.gote.app"
                Description="A secure note-taking application"
                DisplayName="gote"
                ExecutableName="gote.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>gote</DisplayName>
            <PublisherDisplayName>r4b2</PublisherDisplayName>
            <Description>A secure note-taking application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="gote.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
